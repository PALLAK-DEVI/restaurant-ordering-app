# =====================================================================
# RESTAURANT ORDERING PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local to configure live external integrations.
# When unset, the application automatically runs in standalone local mode
# with high-fidelity pre-seeded demo data and simulated test payments.
# =====================================================================

# Supabase PostgreSQL & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay India Payment Gateway (Optional for live UPI/Cards)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Deployment URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
